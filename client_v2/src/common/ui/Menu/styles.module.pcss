/* ── BRST Premium Menu Styles ── */

.menu {
    padding-top: 8px;
    display: none;
    min-height: 100vh;
    max-width: 240px;
    flex-shrink: 0;
    z-index: 1;

    @media (min-width: 1200px) {
        display: flex;
        flex-direction: column;
    }
}

.menuWrapper {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: calc(100vh - 80px);
    padding-bottom: env(safe-area-inset-bottom);

    @media (min-width: 1200px) {
        min-height: 0;
        flex: 1;
    }

    &.headerMenu {
        min-height: 100%;
        justify-content: flex-start;
        gap: 80px;
    }
}

.menuLink,
.accordionLink {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    margin: 2px 10px;
    border-radius: 10px;
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
    color: rgba(180, 210, 248, 0.75);
    text-decoration: none;
    max-width: calc(100% - 20px);
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    vertical-align: middle;
    transition:
        background-color 0.2s ease,
        color 0.2s ease,
        box-shadow 0.2s ease;
    outline: none;
    position: relative;

    &::before {
        content: '';
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%) scaleY(0);
        width: 3px;
        height: 60%;
        border-radius: 0 3px 3px 0;
        background: linear-gradient(180deg, #0d84f8, #00d4ef);
        transition: transform 0.2s ease;
    }

    &:hover,
    &:focus {
        color: #e8f4ff;
        background-color: rgba(13, 132, 248, 0.1);
        text-decoration: none;
        box-shadow: inset 0 0 0 1px rgba(13, 132, 248, 0.12);
    }

    &.activeLink {
        color: #ffffff;
        background: linear-gradient(90deg, rgba(13, 132, 248, 0.2) 0%, rgba(0, 212, 239, 0.08) 100%);
        box-shadow: inset 0 0 0 1px rgba(13, 132, 248, 0.25);
        font-weight: 600;

        &::before {
            transform: translateY(-50%) scaleY(1);
        }

        .linkIcon {
            color: #0d84f8;
        }
    }
}

.accordionLink {
    padding: 10px 16px 10px 52px;
    margin: 1px 10px;
    font-size: 13px;
}

.linkIcon {
    color: rgba(100, 160, 220, 0.7);
    transition: color 0.2s ease;
    flex-shrink: 0;
}

.withConfirmIcon {
    display: flex;
    align-items: center;
}

.topMenuWrapper {
    margin-bottom: auto;

    @media (min-width: 1200px) {
        margin-bottom: 0;
    }
}

.referenceWrapper {
    margin-top: auto;
    border-top: 1px solid rgba(13, 132, 248, 0.1);
    padding-top: 8px;
}

.accordionHeader {
    cursor: pointer;
    user-select: none;
}

.accordionArrow {
    margin-left: auto;
    color: rgba(100, 160, 220, 0.5);
    transition:
        transform 0.2s ease,
        color 0.2s ease;
}

.accordionArrowOpen {
    transform: rotate(180deg);
    color: #0d84f8;
}
