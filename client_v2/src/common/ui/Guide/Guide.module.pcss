.title {
    margin-bottom: 16px;
    font-size: 20px;
    font-weight: 700;
    color: var(--default-main-text, #f8fafc);
}

.inlineCopiedText {
    display: inline-flex;
}

.dhcpLink {
    color: var(--default-link, #00d4ef);
    font-size: 15px;
    font-weight: 500;
}

.dhcpLink:hover {
    text-decoration: underline;
}

.guideText {
    line-height: 1.7;
}

.guideText li,
.guideText p {
    margin-bottom: 6px;
}

.guideText ul,
.guideText ol {
    padding-left: 24px;
}

.guideParagraph {
    margin-bottom: 14px;
}

.guideTitle {
    margin-bottom: 16px;
    font-size: 16px;
    font-weight: 600;
    color: var(--default-main-text, #f8fafc);
}

.strongNumbers {
    counter-reset: strong-counter;
}

.guideList {
    margin-top: 0;
    padding-left: 20px;
}

.strongNumbers li {
    counter-increment: strong-counter;
    list-style: none;
    position: relative;
    margin-bottom: 10px;
}

.strongNumbers li::before {
    content: counter(strong-counter) '.';
    font-weight: bold;
    position: absolute;
    left: -24px;
    color: var(--brst-primary-40, #3498ff);
}

.dnsLink {
    color: var(--default-link, #00d4ef);
    font-size: 15px;
    font-weight: 500;
}

.dnsLink:hover {
    text-decoration: underline;
}

.selectorDesc {
    margin-bottom: 12px;
    font-size: 14px;
    font-weight: 500;
    color: var(--default-description-text, #94a3b8);
}

/* ── Modern Sleek Platform Tab Bar ── */
.deviceSelectorContainer {
    width: 100%;
    margin-bottom: 24px;
}

.tabBar {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 8px;
    margin-bottom: 20px;
    scrollbar-width: thin;

    &::-webkit-scrollbar {
        height: 4px;
    }

    &::-webkit-scrollbar-thumb {
        background: rgba(13, 132, 248, 0.25);
        border-radius: 4px;
    }
}

.tabButton {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    background: var(--brst-bg-surface, #141d2e);
    color: var(--default-description-text, #94a3b8);
    border: 1px solid var(--brst-border-subtle, rgba(255, 255, 255, 0.08));
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    outline: none;

    &:hover {
        background: var(--brst-bg-elevated, #1a253a);
        color: var(--default-main-text, #f8fafc);
        border-color: rgba(13, 132, 248, 0.3);
    }
}

.tabButtonActive {
    background: linear-gradient(135deg, #0d84f8 0%, #0070e0 100%) !important;
    color: #ffffff !important;
    border-color: rgba(255, 255, 255, 0.2) !important;
    box-shadow: 0 4px 16px rgba(13, 132, 248, 0.35);

    .tabIcon {
        color: #ffffff !important;
    }
}

.tabIcon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    transition: color 0.2s ease;
}

.tabTitle {
    line-height: 1;
}

.deviceContent {
    animation: fadeIn 0.25s ease;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(4px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* ── Method & Platform Cards ── */
.platformContainer {
    display: flex;
    flex-direction: column;
}

.methodCard {
    background: var(--brst-bg-card, #111827);
    border: 1px solid var(--brst-border-subtle, rgba(255, 255, 255, 0.08));
    border-radius: 12px;
    padding: 20px 22px;
    margin-bottom: 16px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;

    &:hover {
        border-color: rgba(13, 132, 248, 0.25);
        box-shadow: 0 6px 24px rgba(0, 0, 0, 0.3);
    }
}

.methodHeader {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
    flex-wrap: wrap;
}

.methodBadge {
    background: rgba(13, 132, 248, 0.15);
    color: #38bdf8;
    border: 1px solid rgba(13, 132, 248, 0.35);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 3px 8px;
    border-radius: 6px;
}

.methodBadgeSecondary {
    background: rgba(255, 255, 255, 0.06);
    color: var(--default-description-text, #94a3b8);
    border: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 3px 8px;
    border-radius: 6px;
}

.methodTitle {
    font-size: 16px;
    font-weight: 700;
    color: var(--default-main-text, #f8fafc);
    margin: 0;
}

.methodDesc {
    color: var(--default-description-text, #94a3b8);
    font-size: 14px;
    line-height: 1.5;
    margin-bottom: 12px;
}

.stepList {
    margin: 10px 0 14px 20px;
    padding-left: 0;
    color: var(--default-main-text, #f8fafc);
    font-size: 14px;
    line-height: 1.6;

    li {
        margin-bottom: 6px;
    }
}

.codeHighlightBox {
    background: var(--brst-bg-deepest, #06090f);
    border: 1px solid rgba(13, 132, 248, 0.28);
    border-radius: 10px;
    padding: 12px 16px;
    margin: 12px 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.codeLabel {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #38bdf8;
}

.copyField {
    font-family: var(--font-family-monospace, monospace);
    font-size: 15px;
    font-weight: 600;
    color: #f8fafc;
}

.tipNotice {
    background: rgba(234, 179, 8, 0.08);
    border-left: 3px solid #eab308;
    padding: 10px 14px;
    border-radius: 0 8px 8px 0;
    font-size: 13px;
    line-height: 1.5;
    color: #fef08a;
    margin-top: 10px;
}

.ipGrid {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 10px;
}

.ipPill {
    background: var(--brst-bg-surface, #141d2e);
    border: 1px solid var(--brst-border-subtle, rgba(255, 255, 255, 0.08));
    padding: 6px 12px;
    border-radius: 8px;
    font-family: var(--font-family-monospace, monospace);
    font-size: 14px;
}

.warningBox {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.25);
    border-radius: 8px;
    padding: 12px;
    color: #fca5a5;
    font-size: 14px;
}

.deviceDnsList {
    margin-top: 14px;
}

.deviceDnsListItem,
.guideBulletItem {
    list-style: none;
    position: relative;

    &::before {
        content: '';
        width: 6px;
        height: 6px;
        background-color: #38bdf8;
        border-radius: 50%;
        display: inline-block;
        position: absolute;
        left: -14px;
        top: 8px;
    }
}

.deviceDnsListItem {
    margin-top: 8px;
}

.guideBulletItem {
    margin-bottom: 14px;

    .guideItemTitle {
        display: block;
        font-weight: 600;
        color: var(--default-main-text, #f8fafc);
    }
}

.mobileConfigContainer {
    margin-top: 12px;
}
