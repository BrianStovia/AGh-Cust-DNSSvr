/* ── BRST Sidebar (Hidden on top-nav mode) ── */

.sidebarWrapper {
    display: none !important;
}

.sidebarContainer {
    display: none !important;
}

.sidebar {
    display: none !important;
}

.logo {
    width: 160px;
    height: 24px;
}

.linkWrapper {
    display: flex;
    padding: 16px 20px 28px;
    border-bottom: 1px solid rgba(13, 132, 248, 0.1);
    margin-bottom: 8px;
}

.link {
    text-decoration: none;
    display: block;
    width: 100%;
    transition: opacity 0.2s ease;

    &:hover {
        opacity: 0.85;
    }
}

.logoCompany {
    fill: var(--default-logo-color, #ffffff);
}

.logoProduct {
    fill: var(--brst-cyan-50, #00d4ef);
}
