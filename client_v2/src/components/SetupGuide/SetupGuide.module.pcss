.header {
    padding: 0 16px;
}

.stepRoot {
    max-width: 632px;
    margin: 0 auto;
    padding-top: 24px;
    padding-bottom: 80px;

    @media screen and (min-width: 1024px) {
        padding-top: 48px;
    }

    .guidePage {
        padding-top: 16px;
        padding-bottom: 24px;
        margin: 0 auto;
    }

    .pageTitle {
        font-size: var(--fs-title-h4);
        line-height: var(--lh-h4-normal);

        @media screen and (min-width: 1024px) {
            font-size: var(--fs-title-h3);
            line-height: var(--lh-h3-normal);
        }
    }

    .nav {
        padding: 0 16px;

        @media screen and (min-width: 1024px) {
            padding: 0;
        }
    }
}

.footer {
    padding: 0;

    @media screen and (min-width: 1024px) {
        padding: 0 16px;
    }
}

.pageTitle {
    font-size: var(--fs-title-h4);
    line-height: var(--lh-h4-normal);
    font-weight: var(--weight-bold);
    margin-bottom: 12px;

    @media screen and (min-width: 1024px) {
        font-size: var(--fs-title-h3);
        line-height: var(--lh-h3-normal);
    }
}

.pageDesc {
    font-size: var(--fs-text-t2);
    line-height: var(--lh-t2-normal);
}

.dnsTitle {
    font-size: var(--fs-title-h5);
    line-height: var(--lh-h5-normal);
    font-weight: var(--weight-bold);
    margin-bottom: 12px;
    margin-top: 40px;

    @media screen and (min-width: 768px) {
        font-size: var(--fs-title-h4);
        line-height: var(--lh-h4-normal);
    }
}

.dnsSubtitle {
    margin: 24px 0 12px;
    font-weight: var(--weight-bold);
    font-size: var(--fs-text-t2);
    line-height: var(--lh-t2-normal);

    @media screen and (min-width: 768px) {
        font-size: var(--fs-text-t1);
        line-height: var(--lh-t1-normal);
    }
}

.guidePage {
    padding: 24px 16px;
    max-width: 632px;

    @media screen and (min-width: 768px) {
        padding: 32px 16px;
    }

    @media screen and (min-width: 1024px) {
        padding: 40px 16px;
    }
}

.guideTitle {
    margin-bottom: 24px;
    font-size: var(--fs-title-h5);
    line-height: var(--lh-h5-normal);
    font-weight: var(--weight-bold);

    @media screen and (min-width: 768px) {
        font-size: var(--fs-title-h4);
        line-height: var(--lh-h4-normal);
    }
}

.guideDesc {
    margin-bottom: 24px;
}

.protocolGrid {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 14px;
}

.protocolCard {
    background: var(--brst-bg-card, #111827);
    border: 1px solid var(--brst-border-subtle, rgba(255, 255, 255, 0.08));
    border-radius: 12px;
    padding: 16px 20px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;

    &:hover {
        border-color: rgba(13, 132, 248, 0.25);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
    }
}

.protocolHeader {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
}

.protocolBadge {
    background: rgba(13, 132, 248, 0.15);
    color: #38bdf8;
    border: 1px solid rgba(13, 132, 248, 0.35);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 2px 8px;
    border-radius: 6px;
}

.protocolBadgeSecondary {
    background: rgba(255, 255, 255, 0.06);
    color: var(--default-description-text, #94a3b8);
    border: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 2px 8px;
    border-radius: 6px;
}

.protocolTitle {
    font-size: 15px;
    font-weight: 700;
    color: var(--default-main-text, #f8fafc);
    margin: 0;
}

.protocolDesc {
    color: var(--default-description-text, #94a3b8);
    font-size: 13px;
    line-height: 1.4;
    margin-bottom: 10px;
}

.codeBox {
    background: var(--brst-bg-deepest, #06090f);
    border: 1px solid rgba(13, 132, 248, 0.2);
    border-radius: 8px;
    padding: 8px 14px;
    font-family: var(--font-family-monospace, monospace);
    font-size: 14px;
    font-weight: 600;
}

.ipGrid {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 10px;
}

.ipPill {
    background: var(--brst-bg-deepest, #06090f);
    border: 1px solid var(--brst-border-subtle, rgba(255, 255, 255, 0.08));
    padding: 8px 14px;
    border-radius: 8px;
    font-family: var(--font-family-monospace, monospace);
    font-size: 14px;
}

.addressList {
    list-style: none;
    padding: 0;
    margin: 12px 0 0 0;

    li {
        display: flex;
        align-items: center;
        gap: 8px;
    }
}

.bulletIcon {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--default-main-text);
    flex-shrink: 0;
}

.address {
    padding: 4px 12px;
    border-radius: 4px;
    font-family: var(--font-family-monospace);
    font-size: var(--fs-text-t3);
    line-height: var(--lh-t3-normal);
}

.iosConfigSection {
    margin-top: 40px;
    padding-top: 32px;
}
