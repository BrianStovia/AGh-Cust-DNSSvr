.card {
    background: var(--color-bg-secondary, #111827);
    border: 1px solid var(--color-border-primary, #374151);
    border-radius: 16px;
    padding: 24px;
    margin-bottom: 24px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
}

.header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--color-border-primary, #374151);
}

.titleGroup {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px;
    background: rgba(0, 212, 239, 0.12);
    border: 1px solid rgba(0, 212, 239, 0.35);
    border-radius: 9999px;
    font-size: 11px;
    font-weight: 700;
    color: #00d4ef;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    width: fit-content;
}

.title {
    font-size: 18px;
    font-weight: 700;
    color: var(--color-text-primary, #f9fafb);
    margin: 0;
}

.desc {
    font-size: 13px;
    color: var(--color-text-secondary, #9ca3af);
    margin: 0;
    line-height: 1.5;
}

.grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 14px;
    margin-bottom: 20px;
}

.urlBox {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--color-border-primary, #374151);
    border-radius: 12px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: all 0.2s ease;
}

.urlBox:hover {
    border-color: rgba(0, 212, 239, 0.4);
}

.urlTitle {
    font-size: 12px;
    font-weight: 700;
    color: var(--color-text-secondary, #9ca3af);
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.codeRow {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(10, 15, 29, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 8px 12px;
}

.codeText {
    flex: 1;
    font-family: monospace;
    font-size: 12.5px;
    color: #00d4ef;
    word-break: break-all;
}

.copyBtn {
    padding: 4px 10px;
    background: rgba(0, 212, 239, 0.15);
    border: 1px solid rgba(0, 212, 239, 0.3);
    border-radius: 6px;
    color: #00d4ef;
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
}

.copyBtn:hover {
    background: rgba(0, 212, 239, 0.28);
    transform: translateY(-1px);
}

.guideSection {
    background: rgba(10, 15, 29, 0.6);
    border: 1px solid var(--color-border-primary, #374151);
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 20px;
}

.guideTitle {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--color-text-primary, #f9fafb);
    margin-bottom: 8px;
}

.guideList {
    margin: 0;
    padding-left: 18px;
    font-size: 12.5px;
    color: var(--color-text-secondary, #9ca3af);
    line-height: 1.6;
}

.actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
}

.testBtn {
    padding: 10px 18px;
    background: linear-gradient(135deg, #0284c7 0%, #00d4ef 100%);
    border: none;
    border-radius: 8px;
    color: #031326;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
}

.testBtn:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 15px rgba(0, 212, 239, 0.35);
}

.testResult {
    font-size: 12.5px;
    font-weight: 600;
    color: #4ade80;
    background: rgba(34, 197, 94, 0.12);
    border: 1px solid rgba(34, 197, 94, 0.3);
    padding: 6px 12px;
    border-radius: 6px;
}
