.brandingContainer {
    background: var(--brst-bg-card, #111827);
    border: 1px solid var(--brst-border-subtle, rgba(255, 255, 255, 0.08));
    border-radius: 14px;
    padding: 24px;
    margin-bottom: 24px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
}

.brandingHeader {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
    flex-wrap: wrap;
    gap: 12px;
}

.titleArea {
    display: flex;
    align-items: center;
    gap: 12px;
}

.badge {
    background: rgba(13, 132, 248, 0.15);
    color: #38bdf8;
    border: 1px solid rgba(13, 132, 248, 0.35);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 3px 8px;
    border-radius: 6px;
}

.title {
    font-size: 18px;
    font-weight: 700;
    color: var(--default-main-text, #f8fafc);
    margin: 0;
}

.desc {
    color: var(--default-description-text, #94a3b8);
    font-size: 14px;
    line-height: 1.5;
    margin-bottom: 20px;
}

/* ── Live Preview Box ── */
.previewSection {
    margin-bottom: 24px;
}

.previewLabel {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--default-description-text, #94a3b8);
    margin-bottom: 8px;
}

.previewBox {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    background: var(--brst-bg-deepest, #06090f);
    border: 1px solid rgba(13, 132, 248, 0.25);
    border-radius: 12px;
    flex-wrap: wrap;
    gap: 16px;
}

.previewLogoWrapper {
    display: flex;
    align-items: center;
    gap: 12px;
}

.previewIconBox {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    flex-shrink: 0;
    transition: all 0.3s ease;
}

.previewImg {
    height: 24px;
    width: auto;
    filter: brightness(0) invert(1);
}

.previewTextCol {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
}

.previewMainTitle {
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 1.5px;
    color: #ffffff;
    text-transform: uppercase;
}

.previewSubTitle {
    font-weight: 800;
    font-size: 16px;
    letter-spacing: 2px;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-top: 2px;
}

.previewHint {
    font-size: 13px;
    color: var(--default-description-text, #94a3b8);
}

/* ── Form Inputs ── */
.formGrid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-bottom: 24px;

    @media (min-width: 768px) {
        grid-template-columns: 1fr 1fr;
    }
}

.inputGroup {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.inputLabel {
    font-size: 13px;
    font-weight: 600;
    color: var(--default-main-text, #f8fafc);
}

.textInput {
    background: var(--brst-bg-surface, #141d2e);
    border: 1px solid var(--brst-border-subtle, rgba(255, 255, 255, 0.1));
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 14px;
    color: var(--default-main-text, #f8fafc);
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;

    &:focus {
        border-color: var(--brst-primary-50, #0d84f8);
        box-shadow: 0 0 0 3px rgba(13, 132, 248, 0.2);
    }
}

/* ── Palette Presets ── */
.presetsSection {
    margin-bottom: 24px;
}

.presetGrid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    margin-top: 8px;

    @media (min-width: 600px) {
        grid-template-columns: repeat(2, 1fr);
    }

    @media (min-width: 992px) {
        grid-template-columns: repeat(3, 1fr);
    }
}

.presetCard {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    background: var(--brst-bg-surface, #141d2e);
    border: 1px solid var(--brst-border-subtle, rgba(255, 255, 255, 0.08));
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    outline: none;

    &:hover {
        background: var(--brst-bg-elevated, #1a253a);
        border-color: rgba(255, 255, 255, 0.2);
    }
}

.presetCardActive {
    background: var(--brst-bg-elevated, #1a253a) !important;
    border-color: var(--brst-primary-50, #0d84f8) !important;
    box-shadow: 0 0 12px rgba(13, 132, 248, 0.3);
}

.colorDots {
    display: flex;
    align-items: center;
    position: relative;
    width: 28px;
    height: 20px;
    flex-shrink: 0;
}

.dotPrimary {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    position: absolute;
    left: 0;
    z-index: 2;
    border: 2px solid var(--brst-bg-card, #111827);
}

.dotAccent {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    position: absolute;
    left: 10px;
    z-index: 1;
    border: 2px solid var(--brst-bg-card, #111827);
}

.presetName {
    font-size: 13px;
    font-weight: 600;
    color: var(--default-main-text, #f8fafc);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ── Action Buttons ── */
.actionRow {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    padding-top: 8px;
}
