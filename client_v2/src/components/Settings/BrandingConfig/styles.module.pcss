.brandingContainer {
    background: var(--default-cards-background, #ffffff);
    border: 1px solid var(--default-item-divider, rgba(255, 255, 255, 0.1));
    border-radius: 14px;
    padding: 24px;
    margin-bottom: 32px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.12);
    transition: all 0.3s ease;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
}

.brandingHeader {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    flex-wrap: wrap;
    gap: 12px;
}

.titleArea {
    display: flex;
    align-items: center;
    gap: 12px;
}

.badge {
    background: rgba(13, 132, 248, 0.15);
    color: var(--brst-primary-50, #0d84f8);
    border: 1px solid rgba(13, 132, 248, 0.35);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 3px 8px;
    border-radius: 6px;
}

.title {
    font-size: 18px;
    font-weight: 700;
    color: var(--default-main-text, #0d1f38);
    margin: 0;
}

.desc {
    color: var(--default-description-text, #2a5080);
    font-size: 14px;
    line-height: 1.5;
    margin-bottom: 20px;
}

/* ── Live Preview Box (Sidebar simulation is always dark sleek) ── */
.previewSection {
    margin-bottom: 24px;
}

.previewLabel {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--default-description-text, #2a5080);
    margin-bottom: 8px;
}

.previewBox {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    background: #06090f;
    border: 1px solid rgba(13, 132, 248, 0.3);
    border-radius: 12px;
    flex-wrap: wrap;
    gap: 16px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
}

.previewLogoWrapper {
    display: flex;
    align-items: center;
    gap: 12px;
}

.previewIconBox {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    flex-shrink: 0;
    transition: all 0.3s ease;
}

.previewImg {
    height: 24px;
    width: auto;
    filter: brightness(0) invert(1);
}

.previewTextCol {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
}

.previewMainTitle {
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 1.5px;
    color: #ffffff;
    text-transform: uppercase;
}

.previewSubTitle {
    font-weight: 800;
    font-size: 16px;
    letter-spacing: 2px;
    margin-top: 2px;
    display: inline-block;
}

.previewHint {
    font-size: 13px;
    color: #94a3b8;
}

/* ── Form Inputs ── */
.formGrid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-bottom: 24px;

    @media (min-width: 768px) {
        grid-template-columns: 1fr 1fr;
    }
}

.inputGroup {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.inputLabel {
    font-size: 13px;
    font-weight: 600;
    color: var(--default-main-text, #0d1f38);
}

.textInput {
    background: var(--default-input-background, #f0f6ff);
    border: 1px solid var(--default-inactive-input-stroke, #b0ccee);
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 14px;
    color: var(--default-main-text, #0d1f38);
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;

    &:focus {
        border-color: var(--brst-primary-50, #0d84f8);
        box-shadow: 0 0 0 3px rgba(13, 132, 248, 0.2);
    }
}

/* ── Palette Presets ── */
.presetsSection {
    margin-bottom: 24px;
}

.presetGrid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    margin-top: 8px;
    width: 100%;
    box-sizing: border-box;

    @media (min-width: 600px) {
        grid-template-columns: repeat(2, 1fr);
    }
}

.presetCard {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    background: var(--default-input-background, #f0f6ff);
    border: 1px solid var(--default-inactive-input-stroke, #b0ccee);
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    outline: none;
    min-width: 0;
    box-sizing: border-box;

    &:hover {
        border-color: var(--brst-primary-50, #0d84f8);
    }
}

.presetCardActive {
    border-color: var(--brst-primary-50, #0d84f8) !important;
    box-shadow: 0 0 0 2px var(--brst-primary-50, #0d84f8), 0 0 12px rgba(13, 132, 248, 0.3) !important;
}

.colorDots {
    display: flex;
    align-items: center;
    position: relative;
    width: 28px;
    height: 20px;
    flex-shrink: 0;
}

.dotPrimary {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    position: absolute;
    left: 0;
    z-index: 2;
    border: 2px solid var(--default-cards-background, #ffffff);
}

.dotAccent {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    position: absolute;
    left: 10px;
    z-index: 1;
    border: 2px solid var(--default-cards-background, #ffffff);
}

.presetName {
    font-size: 13px;
    font-weight: 600;
    color: var(--default-main-text, #0d1f38);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ── Action Buttons ── */
.actionRow {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    padding-top: 14px;
    width: 100%;
    box-sizing: border-box;
}

.saveBtn,
.resetBtn {
    min-width: 160px !important;
    max-width: 220px !important;
    width: auto !important;
    height: 44px !important;
    padding: 0 24px !important;
    font-size: 14px !important;
    font-weight: 600 !important;
}

