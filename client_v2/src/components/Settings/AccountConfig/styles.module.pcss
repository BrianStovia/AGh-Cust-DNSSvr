.accountContainer {
    background: var(--default-cards-background, #ffffff);
    border: 1px solid var(--default-item-divider, rgba(255, 255, 255, 0.1));
    border-radius: 14px;
    padding: 24px;
    margin-bottom: 32px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.12);
    transition: all 0.3s ease;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
}

.accountHeader {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    flex-wrap: wrap;
    gap: 12px;
}

.titleArea {
    display: flex;
    align-items: center;
    gap: 12px;
}

.badge {
    background: rgba(16, 185, 129, 0.15);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.35);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 3px 8px;
    border-radius: 6px;
}

.title {
    font-size: 18px;
    font-weight: 700;
    color: var(--default-main-text, #0d1f38);
    margin: 0;
}

.desc {
    color: var(--default-description-text, #2a5080);
    font-size: 14px;
    line-height: 1.5;
    margin-bottom: 20px;
}

/* ── User Info Banner ── */
.userBanner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    background: rgba(13, 132, 248, 0.05);
    border: 1px solid rgba(13, 132, 248, 0.18);
    border-radius: 10px;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 12px;
}

.userInfo {
    display: flex;
    align-items: center;
    gap: 12px;
}

.userAvatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, #0d84f8 0%, #00d4ef 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-weight: 700;
    font-size: 14px;
    box-shadow: 0 2px 8px rgba(13, 132, 248, 0.35);
}

.userMeta {
    display: flex;
    flex-direction: column;
}

.userName {
    font-size: 15px;
    font-weight: 700;
    color: var(--default-main-text, #0d1f38);
}

.userRole {
    font-size: 12px;
    color: var(--default-description-text, #2a5080);
}

.roleTag {
    background: rgba(13, 132, 248, 0.12);
    color: var(--brst-primary-50, #0d84f8);
    border: 1px solid rgba(13, 132, 248, 0.25);
    font-size: 11px;
    font-weight: 600;
    padding: 2px 10px;
    border-radius: 12px;
}

/* ── Form Layout ── */
.formGrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
    margin-bottom: 20px;
}

.fieldGroup {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.label {
    font-size: 13px;
    font-weight: 600;
    color: var(--default-main-text, #0d1f38);
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.inputWrapper {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
}

.input {
    width: 100%;
    height: 42px;
    padding: 0 42px 0 14px;
    border-radius: 8px;
    border: 1px solid var(--default-item-divider, rgba(255, 255, 255, 0.15));
    background: var(--default-input-background, rgba(255, 255, 255, 0.05));
    color: var(--default-main-text, #0d1f38);
    font-size: 14px;
    outline: none;
    transition: all 0.2s ease;
    box-sizing: border-box;
}

.input:focus {
    border-color: var(--brst-primary-50, #0d84f8);
    box-shadow: 0 0 0 3px rgba(13, 132, 248, 0.18);
}

.inputError {
    border-color: #ef4444 !important;
}

.inputError:focus {
    box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.2) !important;
}

.toggleBtn {
    position: absolute;
    right: 10px;
    background: none;
    border: none;
    color: var(--default-description-text, #2a5080);
    cursor: pointer;
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    transition: color 0.2s ease;
}

.toggleBtn:hover {
    color: var(--default-main-text, #0d1f38);
}

/* ── Password Strength Meter ── */
.strengthMeter {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 4px;
}

.strengthBars {
    display: flex;
    gap: 4px;
    height: 4px;
}

.strengthBar {
    flex: 1;
    height: 100%;
    border-radius: 2px;
    background: var(--default-item-divider, rgba(255, 255, 255, 0.12));
    transition: background-color 0.3s ease;
}

.strengthLabel {
    font-size: 11px;
    font-weight: 600;
}

.weak {
    background-color: #ef4444 !important;
    color: #ef4444;
}

.medium {
    background-color: #f59e0b !important;
    color: #f59e0b;
}

.strong {
    background-color: #10b981 !important;
    color: #10b981;
}

/* ── Status Messages ── */
.errorMsg {
    font-size: 12px;
    color: #ef4444;
    margin-top: 2px;
}

.alertBox {
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 13px;
    line-height: 1.4;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
}

.alertError {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #f87171;
}

.alertSuccess {
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: #34d399;
}

/* ── Actions ── */
.actions {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 8px;
}

.submitBtn {
    min-width: 170px;
}
